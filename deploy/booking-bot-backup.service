[Unit]
Description=booking_bot encrypted Postgres backup (age)
Documentation=file:///opt/booking_bot/README.md
After=docker.service
Wants=docker.service
RequiresMountsFor=/opt/booking_bot

[Service]
Type=oneshot
# Adjust User, WorkingDirectory, and ExecStart to your VPS layout.
# No [Install] — start only via booking-bot-backup.timer (or systemctl start).
# Script loads .env itself (dotenv_fill); do not use EnvironmentFile= here.
User=deploy
Group=deploy
WorkingDirectory=/opt/booking_bot
# Ensure docker + age are on PATH for non-login services.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/booking_bot/scripts/backup_postgres.sh

# Do not restart on failure — the timer will try again next calendar tick.
Nice=10
# Harden lightly; dump still needs Docker socket + read .env.
NoNewPrivileges=true
PrivateTmp=true
