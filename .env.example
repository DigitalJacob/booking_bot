# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT="[%(asctime)s] #%(levelname)-8s %(filename)s:%(lineno)d - %(name)s - %(message)s"

# Bot
BOT_TOKEN=your_bot_token
ADMIN_IDS=your_admin_IDs
MASTER_USER_ID=your_master_telegram_user_ID
TIMEZONE=Europe/Moscow # IANA timezone for display and slot input (storage stays UTC)
# Schedule shape for this deploy (pick once; switching is not supported):
#   weekly  — repeating Mon–Sun working hours
#   monthly — pick open days on a calendar each month
SCHEDULE_MODE=weekly

# Personal-data consent (short notice in the bot; full text via URL when set)
PDN_CONSENT_VERSION=v1
PDN_OPERATOR_NAME=
PDN_OPERATOR_CONTACTS=
# Optional https link shown as «Full terms» (Google Docs / Telegraph, etc.)
PDN_POLICY_URL=

# Appointment reminders (confirmed only; times in TIMEZONE)
# Hour reminder: send when starts_at is within this many minutes
REMINDER_LEAD_MINUTES=60
# Evening reminder: half-open local hour window [START, END) on the day before
REMINDER_EVENING_HOUR_START=20
REMINDER_EVENING_HOUR_END=22

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# PgAdmin
PGADMIN_DEFAULT_EMAIL=sample@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
PGADMIN_PORT=5050

# Redis
REDIS_DATABASE=1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=your_redis_username
REDIS_PASSWORD=your_redis_password

# Proxy - to enable the proxy, uncomment the following 5 lines and fill in your credentials.
#PROXY_TYPE=http
#PROXY_LOGIN=sample_proxy_login
#PROXY_PASSWORD=sample_proxy_password
#PROXY_IP=sample_proxy_ip
#PROXY_PORT=sample_proxy_port